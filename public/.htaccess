<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si fichier ou dossier existe, on le sert normalement
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Sinon, fallback sur index.html (Vue Router history)
  RewriteRule ^ index.html [L]
</IfModule>
